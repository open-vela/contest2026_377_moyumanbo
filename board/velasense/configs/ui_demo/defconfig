#
# VelaSense Board Configuration
# Based on SF32LB52-DevKit-LCD
# Target: 腕式情绪唤醒识别终端
#

# --- Architecture ---
CONFIG_ARCH="arm"
CONFIG_ARCH_BOARD_CUSTOM=y
CONFIG_ARCH_BOARD_CUSTOM_DIR="../vendor/sifli/boards/sf32lb52/sf32lb52_devkit_lcd"
CONFIG_ARCH_BOARD_CUSTOM_DIR_RELPATH=y
CONFIG_ARCH_BOARD_CUSTOM_NAME="nsh"
CONFIG_ARCH_CHIP_ARM_CUSTOM=y
CONFIG_ARCH_CHIP_CUSTOM=y
CONFIG_ARCH_CHIP_CUSTOM_DIR="../vendor/sifli/chips/sf32lb52"
CONFIG_ARCH_CHIP_CUSTOM_DIR_RELPATH=y
CONFIG_ARCH_CHIP_CUSTOM_NAME="sf32lb52"
CONFIG_ARCH_CHIP_SF32LB52=y
CONFIG_ARMV8M_SYSTICK=y
CONFIG_ARCH_FPU=y
CONFIG_ARCH_DSP=y
CONFIG_ARM_MPU=y

# --- System ---
CONFIG_BOARD_EARLY_INITIALIZE=y
CONFIG_BOARD_LATE_INITIALIZE=y
CONFIG_BOARD_LOOPSPERMSEC=8499
CONFIG_NSH_LIBRARY=y
CONFIG_SYSTEM_NSH=y
CONFIG_INIT_ENTRYPOINT="velasense_main"
CONFIG_INIT_STACKSIZE=32768
CONFIG_DEFAULT_TASK_STACKSIZE=16096
CONFIG_IDLETHREAD_STACKSIZE=16096

# --- Memory ---
CONFIG_MM_REGIONS=2

# --- Console / UART ---
CONFIG_UART_SERIAL_CONSOLE=y
CONFIG_UART_BAUD=1000000
CONFIG_UART_BUFSZ=1024
CONFIG_BSP_USING_UART1=y
CONFIG_BSP_USING_UART2=y
CONFIG_BSP_UART1_RX_USING_DMA=y
CONFIG_BSP_UART2_RX_USING_DMA=y

# --- LCD / Display ---
CONFIG_SIFLI_LCD=y
CONFIG_LCD_USING_CO5300=y
CONFIG_LCD=y
CONFIG_LCD_DEV=y
CONFIG_LCD_MAXPOWER=100
CONFIG_BSP_USING_LCDC=y
CONFIG_DRIVERS_VIDEO=y
# CONFIG_EXAMPLES_LVGLDEMO is not set

# --- Touch ---
CONFIG_BSP_USING_TOUCHD=y
CONFIG_INPUT_FT6146=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCH_IRQ_PIN=31

# --- LVGL ---
CONFIG_GRAPHICS_LVGL=y
CONFIG_LV_USE_NUTTX=y
CONFIG_LV_USE_NUTTX_LCD=y
CONFIG_LV_USE_NUTTX_TOUCHSCREEN=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_CLIB_STRING=y
# CONFIG_LV_USE_DEMO_WIDGETS is not set

# --- PWM ---
CONFIG_PWM=y
CONFIG_BSP_USING_PWM=y
CONFIG_BSP_USING_PWM2=y

# --- GPIO ---
CONFIG_DEV_GPIO=y

# --- I2C ---
CONFIG_I2C=y
CONFIG_I2C_DRIVER=y
CONFIG_BSP_USING_I2C=y
CONFIG_BSP_USING_I2C1=y
CONFIG_BSP_USING_I2C2=y

# --- Work Queue ---
CONFIG_SCHED_HPWORK=y
CONFIG_SCHED_LPWORK=y
CONFIG_SYSTEM_WORKQUEUE_NO_YIELD=y
CONFIG_SYSTEM_WORKQUEUE_STACK_SIZE=32768

# --- SPI ---
CONFIG_SPI=y
CONFIG_SPI_DRIVER=y
CONFIG_BSP_USING_SPI=y
CONFIG_BSP_USING_SPI1=y

# --- ADC ---
CONFIG_ADC=y
CONFIG_ANALOG=y
CONFIG_BSP_USING_ADC=y

# --- RTC ---
CONFIG_RTC=y
CONFIG_BSP_USING_RTC=y
CONFIG_RTC_ALARM=y
CONFIG_RTC_ARCH=y
CONFIG_RTC_DATETIME=y
CONFIG_RTC_DRIVER=y

# --- Watchdog ---
CONFIG_WATCHDOG=y
CONFIG_BSP_USING_WDT=y

# --- Timer ---
CONFIG_TIMER=y
CONFIG_BSP_USING_TIM=y
CONFIG_BSP_USING_BTIM1=y

# --- Buttons ---
CONFIG_INPUT=y
CONFIG_INPUT_BUTTONS=y
CONFIG_INPUT_BUTTONS_NBUTTONS=2

# --- Flash / MTD ---
CONFIG_MTD=y
CONFIG_MTD_BYTE_WRITE=y
CONFIG_BSP_USING_MPI2=y
CONFIG_FS_LITTLEFS=y
CONFIG_FS_LITTLEFS_PROGRAM_SIZE_FACTOR=1
CONFIG_FS_LOCK_BUCKET_SIZE=4
CONFIG_FS_ROMFS=y
CONFIG_ETC_ROMFS=y
CONFIG_FS_PROCFS=y
CONFIG_FS_TMPFS=y
CONFIG_FS_FAT=y

# --- Bluetooth (disabled for now, zblue has build issues) ---
# CONFIG_BT is not set
# CONFIG_DRIVERS_BLUETOOTH is not set
# CONFIG_DRIVERS_WIRELESS is not set

# --- USB ---
CONFIG_USBDEV=y
CONFIG_CDCACM=y
CONFIG_CDCACM_EPBULKIN=1
CONFIG_CDCACM_EPBULKOUT=2
CONFIG_CDCACM_EPINTIN=3
CONFIG_CDCACM_VENDORID=0x38F4
CONFIG_SF32LB52_USBDEV=y

# --- uORB Sensor Framework ---
CONFIG_UORB=y

# --- VelaSense Application ---

# --- NSH Built-in Apps ---
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_BUILTIN=y

# --- Debug ---
CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_ASSERTIONS=y
CONFIG_DEBUG_SCHED=y
CONFIG_DEBUG_SYMBOLS=y
CONFIG_SCHED_BACKTRACE=y
CONFIG_SYSTEM_DUMPSTACK=y

# Display-only application
CONFIG_VELASENSE_UI_DEMO=y
CONFIG_LCD_HOR_RES_MAX=390
CONFIG_LCD_VER_RES_MAX=450
CONFIG_TIMER_ARCH=y
# CONFIG_LCD_FRAMEBUFFER is not set
# CONFIG_VIDEO_FB is not set
# CONFIG_EXAMPLES_FB is not set
# CONFIG_LV_NUTTX_LCD_SINGLE_BUFFER is not set
# CONFIG_LV_NUTTX_LCD_DOUBLE_BUFFER is not set
CONFIG_LV_NUTTX_LCD_CUSTOM_BUFFER=y
CONFIG_LV_NUTTX_LCD_BUFFER_SIZE=40
CONFIG_LV_NUTTX_LCD_BUFFER_COUNT=0

# Boot diagnostics on the physical UART console
CONFIG_SYSLOG_CHAR=y
CONFIG_SYSLOG_DEVPATH="/dev/console"
CONFIG_SYSLOG_BUFFER=y
CONFIG_SYSLOG_INTBUFFER=y
CONFIG_INIT_ENTRYNAME="velasense"

# Demo refresh does not wait for the external tearing-effect signal.
# CONFIG_LCD_CO5300_VSYNC_ENABLE is not set
# HAL microsecond delays assume a 1ms SysTick period.
CONFIG_USEC_PER_TICK=1000
