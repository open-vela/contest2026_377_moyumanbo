#
# VelaSense Board Configuration
# Based on SF32LB52-DevKit-LCD
# Target: 腕式情绪唤醒识别终端
#

# --- Architecture ---
CONFIG_ARCH="arm"
CONFIG_ARCH_ARM=y
CONFIG_ARCH_ARMV8M=y
CONFIG_ARCH_CORTEXM33=y
CONFIG_ARCH_CHIP_SF32LB52=y
CONFIG_ARCH_CHIP_CUSTOM_DIR="../vendor/sifli/chips/sf32lb52"
CONFIG_ARCH_FPU=y
CONFIG_ARCH_DSP=y
CONFIG_ARM_MPU=y
CONFIG_ARCH_BOARD="velasense_board"
CONFIG_ARCH_BOARD_CUSTOM_DIR="../contest2026_377_moyumanbo/firmware/boards/velasense_board"
CONFIG_BOARD_LOOPSPERMSEC=8499

# --- System ---
CONFIG_BOARD_LATE_INITIALIZE=y
CONFIG_BOARDCTL=y
CONFIG_NSH_LIBRARY=y
CONFIG_SYSTEM_NSH=y
CONFIG_INIT_ENTRYPOINT="nsh_main"

# --- Memory ---
CONFIG_MM_HEAP_MEMPOOLSIZE=8388608
CONFIG_MM_DEFAULT_ALIGNMENT=8

# --- Console / UART ---
CONFIG_UART1_SERIAL_CONSOLE=y
CONFIG_UART1_BAUD=1000000
CONFIG_UART1_BITS=8
CONFIG_UART1_PARITY=0
CONFIG_UART1_2STOP=0
CONFIG_SERIAL_TERMIOS=y

# --- Debug UART ---
CONFIG_UART2_SERIAL=y
CONFIG_UART2_BAUD=1000000

# --- LCD / Display ---
CONFIG_SIFLI_LCD=y
CONFIG_LCD_USING_CO5300=y
CONFIG_LCD=y
CONFIG_LCD_DEV=y
CONFIG_LCD_FRAMEBUFFER=y
CONFIG_LCD_MAXPOWER=100
CONFIG_BSP_USING_LCDC=y
CONFIG_VIDEO_FB=y

# --- Touch ---
CONFIG_BSP_USING_TOUCHD=y
CONFIG_INPUT_FT6146=y
CONFIG_INPUT_TOUCHSCREEN=y

# --- LVGL ---
CONFIG_GRAPHICS_LVGL=y
CONFIG_LV_USE_NUTTX=y
CONFIG_LV_USE_NUTTX_LCD=y
CONFIG_LV_USE_NUTTX_TOUCHSCREEN=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_THEME_DEFAULT_DARK=y

# --- Backlight PWM ---
CONFIG_PWM=y
CONFIG_BSP_USING_PWM=y
CONFIG_SIFLI_PWM=y

# --- GPIO ---
CONFIG_DEV_GPIO=y
CONFIG_BSP_USING_GPIO=y

# --- I2C ---
CONFIG_I2C=y
CONFIG_BSP_USING_I2C1=y

# --- SPI ---
CONFIG_SPI=y
CONFIG_BSP_USING_SPI1=y

# --- ADC ---
CONFIG_ADC=y
CONFIG_BSP_USING_ADC=y
CONFIG_SIFLI_ADC=y

# --- RTC ---
CONFIG_RTC=y
CONFIG_BSP_USING_RTC=y
CONFIG_SIFLI_RTC=y

# --- Watchdog ---
CONFIG_WATCHDOG=y
CONFIG_BSP_USING_WDT=y
CONFIG_SIFLI_IWDG=y

# --- Timer ---
CONFIG_TIMER=y
CONFIG_BSP_USING_TIM=y

# --- Buttons ---
CONFIG_INPUT_BUTTONS=y
CONFIG_INPUT_BUTTONS_NBUTTONS=2

# --- Flash / MTD ---
CONFIG_MTD=y
CONFIG_SIFLI_FLASH=y
CONFIG_BSP_USING_MPI2=y
CONFIG_FS_LITTLEFS=y
CONFIG_FS_ROMFS=y
CONFIG_FS_PROCFS=y
CONFIG_FS_TMPFS=y

# --- Bluetooth ---
CONFIG_BT=y
CONFIG_BT_CLASSIC=y
CONFIG_BT_BLE=y
CONFIG_BT_GATT_CLIENT=y
CONFIG_BT_GATT_DYNAMIC_DB=y
CONFIG_BT_H4=y
CONFIG_BT_POWER_MODE_CONTROL=y
CONFIG_BT_PRIVACY=y
CONFIG_DRIVERS_BLUETOOTH=y
CONFIG_DRIVERS_WIRELESS=y

# --- USB ---
CONFIG_USBDEV=y
CONFIG_CDCACM=y
CONFIG_SF32LB52_USBDEV=y

# --- uORB Sensor Framework ---
CONFIG_UORB=y

# --- VelaSense Application ---
CONFIG_VELASENSE=y

# --- Power Management ---
CONFIG_PM=y

# --- Filesystems ---
CONFIG_FS=y
