# VelaSense Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env to git.

# Mimo Token Plan (user-authorized event summaries only)
MIMO_API_BASE=
MIMO_API_KEY=
MIMO_MODEL=
MIMO_DAILY_TOKEN_BUDGET=

# BLE Configuration
BLE_DEVICE_NAME=VelaSense-377

# Debug
VELASENSE_LOG_LEVEL=info
